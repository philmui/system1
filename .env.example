# Copy this file ONLY when .env does not already exist. Never expose keys to Vite.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Optional excerpt traces ONLY for server-marked synthetic inputs. Uploads remain filtered.
LANGSMITH_TRACE_SYNTHETIC_TEXT=false
LANGSMITH_PROJECT=document-discovery-studio
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
APP_DATA_DIR=.runtime
# Explicit: live or test-fixture. Fixtures are displayed as Simulated.
APP_MODE=live
JEV_CHOICE_THRESHOLD=0.80
JEV_RELEVANCE_THRESHOLD=0.70
JEV_SUPPORT_THRESHOLD=0.80
MAX_CONCURRENCY=4
MAX_UPLOAD_BYTES=5000000
PROVIDER_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public build-time value. Provider secrets must never use the VITE_ prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000
